# -------------------------------------------------------
# NiFi Monitor - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# -------------------------------------------------------

# URL base do NiFi (sem /nifi no final)
NIFI_BASE_URL=https://nifi-tierc.lincros.com/nifi

# Credenciais (deixe em branco se o NiFi não exigir login)
NIFI_USERNAME=
NIFI_PASSWORD=

# Validar certificado SSL (true/false)
NIFI_VERIFY_SSL=false

# Intervalo de polling em segundos
POLL_INTERVAL=30

# Máximo de bulletins mantidos na memória
MAX_HISTORY=500
